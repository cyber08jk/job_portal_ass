{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/build",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/server"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/server"
    },
    {
      "source": "/jobs/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/apply/:path*",
      "destination": "/api/server"
    }
  ]
}
