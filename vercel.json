{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/build",
  "builds": [
    {
      "src": "Backend/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "Backend/server.js"
    },
    {
      "src": "/auth/(.*)",
      "dest": "Backend/server.js"
    },
    {
      "src": "/jobs/(.*)",
      "dest": "Backend/server.js"
    },
    {
      "src": "/jobs",
      "dest": "Backend/server.js"
    },
    {
      "src": "/apply/(.*)",
      "dest": "Backend/server.js"
    },
    {
      "src": "/apply",
      "dest": "Backend/server.js"
    },
    {
      "src": "/static/(.*)",
      "dest": "frontend/build/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/build/index.html"
    }
  ]
}
