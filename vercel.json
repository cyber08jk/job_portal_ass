{
  "version": 2,
  "builds": [
    {
      "src": "Backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "Backend/server.js"
    },
    {
      "src": "/auth/(.*)",
      "dest": "Backend/server.js"
    },
    {
      "src": "/jobs/(.*)",
      "dest": "Backend/server.js"
    },
    {
      "src": "/jobs",
      "dest": "Backend/server.js"
    },
    {
      "src": "/apply/(.*)",
      "dest": "Backend/server.js"
    },
    {
      "src": "/apply",
      "dest": "Backend/server.js"
    },
    {
      "src": "/static/(.*)",
      "dest": "frontend/build/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/build/index.html"
    }
  ]
}
